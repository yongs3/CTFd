# FRP authentication token (generate with: openssl rand -hex 16)
FRP_TOKEN=changeme

# Domain for HTTP challenges (use IP.nip.io if no domain)
FRP_SUBDOMAIN_HOST=127.0.0.1.nip.io

# LLM API proxy upstream (for challenges that need external LLM access)
# nginx :8888 proxies to this host via HTTPS
LLM_PROXY_UPSTREAM=your-llm-api.example.com
